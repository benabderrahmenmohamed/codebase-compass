# Copy this file to `.env` and fill in your key.
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit a real key: anything pushed to a public
# repository must be treated as compromised and rotated immediately, even if
# the commit is deleted afterwards.
#
# Without a key the whole tool still works. You get the file map, the
# findings, the scores and the grade — everything except the explanations,
# and the report says so rather than pretending they were unnecessary.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Raises GitHub's rate limit for repository fetching from 60
# requests an hour to 5000. It grants no access the tool lacks without it:
# only public repositories are read, so this is throughput, not permission.
GITHUB_TOKEN=

# Optional. Where the SQLite database lives. Defaults to backend/data/compass.db.
COMPASS_DB=

# REQUIRED for logging in. Signs and verifies JSON Web Tokens.
#
# There is deliberately no default: a hardcoded development secret is the
# most-copied security bug in web tutorials, and anyone who has read the
# source could mint an administrator token. Must be at least 32 bytes, which
# is what RFC 7518 requires for HS256 — a shorter key can be brute-forced
# offline from a single captured token.
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it invalidates every token already issued, which is the only way
# to revoke them all at once.
COMPASS_JWT_SECRET=

# Optional, self-closing, and needed exactly once. A shared secret that may
# create the FIRST administrator while the users table is empty; it stops
# working the moment any user exists. Must be at least 16 characters, and a
# shorter value is treated as none rather than as a weak one.
#
# Presented as an X-Bootstrap-Token header, and compared in constant time so
# the comparison does not leak the value one character at a time.
COMPASS_BOOTSTRAP_TOKEN=

# Optional. Where notification email is sent from. Without a host, the email
# channel reports "not_configured" rather than claiming a message was sent.
COMPASS_SMTP_HOST=
COMPASS_SMTP_PORT=
COMPASS_SMTP_FROM=
